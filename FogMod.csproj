<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>FogMod</AssemblyName>
    <RootNamespace>FogMod</RootNamespace>
    <Version>$(VersionPrefix)</Version>
    <VersionPrefix>0.4</VersionPrefix>
    <Authors>jakeetaylor</Authors>
    <Company>jakeetaylor</Company>
    <Product>Fog Mod</Product>
    <Description>A mod that adds grouse and fog effects to Stardew Valley</Description>
    <Copyright>Copyright © 2024</Copyright>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <!-- Location of the Stardew Valley game folder (containing the DLLs below).
       Defaults per OS; override with -p:StardewValleyDir="..." or the StardewValleyDir env var. -->
  <PropertyGroup>
    <StardewValleyDir Condition="'$(StardewValleyDir)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/Stardew Valley/Contents/MacOS</StardewValleyDir>
    <StardewValleyDir Condition="'$(StardewValleyDir)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/.local/share/Steam/steamapps/common/Stardew Valley</StardewValleyDir>
    <StardewValleyDir Condition="'$(StardewValleyDir)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(ProgramFiles(x86))/Steam/steamapps/common/Stardew Valley</StardewValleyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(StardewValleyDir)/smapi-internal/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SMAPI">
      <HintPath>$(StardewValleyDir)/StardewModdingAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SMAPI.Toolkit.CoreInterfaces">
      <HintPath>$(StardewValleyDir)/smapi-internal/SMAPI.Toolkit.CoreInterfaces.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Stardew Valley">
      <HintPath>$(StardewValleyDir)/Stardew Valley.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>$(StardewValleyDir)/MonoGame.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics">
      <HintPath>$(StardewValleyDir)/MonoGame.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="xTile">
      <HintPath>$(StardewValleyDir)/xTile.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="StardewValley.GameData">
      <HintPath>$(StardewValleyDir)/StardewValley.GameData.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Archery/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project> 